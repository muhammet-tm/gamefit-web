---
import { navSections } from '../content/sections';
import MobileMenu from '../islands/MobileMenu';
import Logo from './Logo.astro';

const isHome = Astro.url.pathname === '/';
const items = navSections.map((s) => ({
  label: s.navLabel as string,
  href: isHome ? `#${s.id}` : (s.route as string),
}));
---
<header
  class="sticky top-0 z-40 border-b border-transparent bg-gf-bg/80 backdrop-blur-md transition-colors"
  data-site-header
>
  <div class="mx-auto flex h-16 max-w-[var(--container-site)] items-center justify-between px-[clamp(1.25rem,5vw,4rem)]">
    <!-- The drawn lockup, not Archivo set in caps. They were never the same
         shapes: the real mark is chamfered with a pointed A and a deep M, so
         the site header was showing an approximation of a logo the favicon in
         the same tab already rendered correctly. -->
    <a href="/" class="rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gf-gold">
      <Logo size={32} />
    </a>

    <!-- lg, not md: at exactly 768px the wordmark, seven links and the CTA
         need 783px and push the page into horizontal scroll. Tablet portrait
         gets the overlay menu, which suits it anyway. The lockup is wider than
         the old text wordmark, so this threshold matters more, not less. -->
    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {items.map((item) => (
          <li>
            <a href={item.href} class="text-sm text-gf-muted transition-colors hover:text-gf-text">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/beta"
        class="hidden rounded-md bg-gf-gold px-5 py-2.5 text-sm font-bold text-gf-bg transition-opacity hover:opacity-90 lg:inline-block"
      >
        Join waitlist
      </a>
      <MobileMenu items={items} client:load />
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  if (header) {
    const onScroll = () => {
      header.classList.toggle('border-gf-border', window.scrollY > 8);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
