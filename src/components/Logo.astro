---
/**
 * The GameFit lockup: husky mascot plus the drawn GAMEFIT lettering.
 *
 * The mascot is the coach pup's head (2026-11-15): a Siberian husky in slate
 * #5E6672 and white with ice-blue eyes, the same face the app animates as
 * Coach Gus. It replaced the goggled orange husky of 2026-09-24. The orange
 * stays in the brand on FIT.
 *
 * The canonical geometry lives in the app repo at `src/lib/brand.js`, and the
 * handoff kit it generates is `brand/*.svg` there. This file is the same
 * shapes, transcribed for Astro. Two repos, no shared package, so if the mark
 * ever changes, regenerate `brand/logo-horizontal-on-dark.svg` in the app and
 * bring the path data across — do not redraw it by eye.
 *
 * Inline rather than an <img>: the header is above the fold on every route, so
 * a linked file is a render-blocking round trip, and the lettering can take
 * its colour from the palette instead of being baked into a PNG. It costs
 * about 2.4 KB gzipped per page against budgets of 30 KB JS and 20 KB CSS.
 *
 * The lettering is vector on purpose. It arrived once as a base64 PNG inside
 * an SVG wrapper, which could not scale past 1486px, could not be recoloured,
 * and could not drive embroidery, foil, vinyl or laser cutting.
 */
interface Props {
  /** Height of the mascot in px. The lettering scales from it. */
  size?: number;
  class?: string;
}

const { size = 34, class: className = '' } = Astro.props;
const wordHeight = size * 0.56;
const wordWidth = (wordHeight * 601) / 100;

// Two rigs, same head. Below 48px the detailed one loses: its catchlights
// are r=3 on the rig grid, a fraction of a pixel at 32px, so they render as
// grey specks. The simplified rig drops them with the brow spots, blush and
// tongue, enlarges the eyes, and thickens the outline 4 -> 5.5. Same threshold
// the React <Mascot> uses.
const detailed = size > 48;

// Shapes are in the coordinates of the app's animated rig and placed on the
// 200-unit grid by HEAD_ON_GRID, exactly as `src/lib/brand.js` does. Copied
// from that file's MASCOT_DETAILED and MASCOT_SIMPLE (exported, not retyped).
type Shape = { t: 'path' | 'ellipse' | 'circle'; a: Record<string, string | number> };
const HEAD_ON_GRID = 'translate(100 100) scale(1.6) translate(-100 -71)';

const DETAILED: Shape[] = [
  { t: 'path', a: { d: 'M56,66 L61,16 Q66,13 72,17 L94,44 Z', fill: '#5E6672' } },
  { t: 'path', a: { d: 'M144,66 L139,16 Q134,13 128,17 L106,44 Z', fill: '#5E6672' } },
  { t: 'path', a: { d: 'M64,56 L66,28 L84,44 Z', fill: '#E9B8B0', stroke: 'none' } },
  { t: 'path', a: { d: 'M136,56 L134,28 L116,44 Z', fill: '#E9B8B0', stroke: 'none' } },
  { t: 'ellipse', a: { cx: 100, cy: 80, rx: 53, ry: 47, fill: '#5E6672' } },
  { t: 'path', a: { d: 'M50,86 C50,72 63,63 74,66 C83,69 88,76 92,68 L100,38 L108,68 C112,76 117,69 126,66 C137,63 150,72 150,86 C150,111 129,127 100,127 C71,127 50,111 50,86 Z', fill: '#F4F4F2', stroke: 'none' } },
  { t: 'ellipse', a: { cx: 78, cy: 62, rx: 5, ry: 3.4, fill: '#F4F4F2', stroke: 'none' } },
  { t: 'ellipse', a: { cx: 122, cy: 62, rx: 5, ry: 3.4, fill: '#F4F4F2', stroke: 'none' } },
  { t: 'circle', a: { cx: 79, cy: 83, r: 12, fill: '#434A55', stroke: 'none' } },
  { t: 'circle', a: { cx: 121, cy: 83, r: 12, fill: '#434A55', stroke: 'none' } },
  { t: 'circle', a: { cx: 79, cy: 83, r: 10, fill: '#7FC8F0', 'stroke-width': 3 } },
  { t: 'circle', a: { cx: 121, cy: 83, r: 10, fill: '#7FC8F0', 'stroke-width': 3 } },
  { t: 'circle', a: { cx: 79, cy: 84, r: 5.5, fill: '#18181B', stroke: 'none' } },
  { t: 'circle', a: { cx: 121, cy: 84, r: 5.5, fill: '#18181B', stroke: 'none' } },
  { t: 'circle', a: { cx: 82.5, cy: 79.5, r: 3, fill: '#FFFFFF', stroke: 'none' } },
  { t: 'circle', a: { cx: 124.5, cy: 79.5, r: 3, fill: '#FFFFFF', stroke: 'none' } },
  { t: 'ellipse', a: { cx: 68, cy: 102, rx: 7, ry: 4, fill: '#F28C8C', opacity: 0.35, stroke: 'none' } },
  { t: 'ellipse', a: { cx: 132, cy: 102, rx: 7, ry: 4, fill: '#F28C8C', opacity: 0.35, stroke: 'none' } },
  { t: 'path', a: { d: 'M91,97 Q100,93 109,97 Q105,105 100,106 Q95,105 91,97 Z', fill: '#18181B', stroke: 'none' } },
  { t: 'path', a: { d: 'M89,108 Q100,124 111,108 Z', fill: '#18181B', stroke: 'none' } },
  { t: 'path', a: { d: 'M95,115 Q100,121 105,115 Z', fill: '#F07C86', stroke: 'none' } },
];

const SIMPLE: Shape[] = [
  { t: 'path', a: { d: 'M56,66 L61,16 Q66,13 72,17 L94,44 Z', fill: '#5E6672' } },
  { t: 'path', a: { d: 'M144,66 L139,16 Q134,13 128,17 L106,44 Z', fill: '#5E6672' } },
  { t: 'path', a: { d: 'M64,56 L66,28 L84,44 Z', fill: '#E9B8B0', stroke: 'none' } },
  { t: 'path', a: { d: 'M136,56 L134,28 L116,44 Z', fill: '#E9B8B0', stroke: 'none' } },
  { t: 'ellipse', a: { cx: 100, cy: 80, rx: 53, ry: 47, fill: '#5E6672' } },
  { t: 'path', a: { d: 'M50,86 C50,72 63,63 74,66 C83,69 88,76 92,68 L100,38 L108,68 C112,76 117,69 126,66 C137,63 150,72 150,86 C150,111 129,127 100,127 C71,127 50,111 50,86 Z', fill: '#F4F4F2', stroke: 'none' } },
  { t: 'circle', a: { cx: 79, cy: 84, r: 12.5, fill: '#434A55', stroke: 'none' } },
  { t: 'circle', a: { cx: 121, cy: 84, r: 12.5, fill: '#434A55', stroke: 'none' } },
  { t: 'circle', a: { cx: 79, cy: 84, r: 10, fill: '#7FC8F0', stroke: 'none' } },
  { t: 'circle', a: { cx: 121, cy: 84, r: 10, fill: '#7FC8F0', stroke: 'none' } },
  { t: 'circle', a: { cx: 79, cy: 85, r: 6, fill: '#18181B', stroke: 'none' } },
  { t: 'circle', a: { cx: 121, cy: 85, r: 6, fill: '#18181B', stroke: 'none' } },
  { t: 'path', a: { d: 'M91,97 Q100,93 109,97 Q105,105 100,106 Q95,105 91,97 Z', fill: '#18181B', stroke: 'none' } },
  { t: 'path', a: { d: 'M88,108 Q100,126 112,108 Z', fill: '#18181B', stroke: 'none' } },
];

const shapes = detailed ? DETAILED : SIMPLE;

const GAME = [
  'M46,40 L92,40 L92,64 L83,73 L46,73 Z',
  'M37,0 L49,0 L86,100 L59,100 L52,80 L34,80 L27,100 L0,100 Z M43,26 L35,60 L51,60 Z',
  'M0,100 L0,0 L27,0 L53,60 L79,0 L106,0 L106,100 L79,100 L79,46 L61,86 L45,86 L27,46 L27,100 Z',
  'M0,0 L67,0 L76,9 L76,25 L27,25 L27,37 L66,37 L66,62 L27,62 L27,75 L76,75 L76,91 L67,100 L0,100 Z',
];
const FIT = [
  'M0,0 L65,0 L74,9 L74,25 L27,25 L27,40 L65,40 L65,65 L27,65 L27,100 L0,100 Z',
  'M0,0 L27,0 L27,100 L0,100 Z',
  'M9,0 L71,0 L80,9 L80,25 L53,25 L53,100 L27,100 L27,25 L0,25 L0,9 Z',
];
const GAME_X = [0, 102, 198, 314];
const FIT_X = [400, 484, 521];
---

<span class:list={['inline-flex items-center', className]} style={`gap:${size * 0.26}px`}>
  <svg
    width={size}
    height={size}
    viewBox="0 0 200 200"
    aria-hidden="true"
    focusable="false"
    class="shrink-0"
  >
    <g
      transform={HEAD_ON_GRID}
      stroke="#18181B"
      stroke-width={detailed ? 4 : 5.5}
      stroke-linejoin="round"
      stroke-linecap="round"
    >
      {shapes.map(({ t: Tag, a }) => <Tag {...a} />)}
    </g>
  </svg>

  <svg
    width={wordWidth}
    height={wordHeight}
    viewBox="0 0 601 100"
    aria-hidden="true"
    focusable="false"
    class="shrink-0"
  >
    <g fill="var(--color-gf-text)">
      {/* The G is an arc plus a bar, not one path: as a single path the bar
          reads as a second subpath and punches a notch out of the bowl. */}
      <path
        d="M72.6,29.1 A32.5,36.5 0 1 0 72.6,70.9"
        fill="none"
        stroke="var(--color-gf-text)"
        stroke-width="27"
        stroke-linecap="butt"
      />
      {GAME.map((d, i) => (
        <path transform={`translate(${GAME_X[i]},0)`} d={d} fill-rule={i === 1 ? 'evenodd' : undefined} />
      ))}
    </g>
    {/* FIT takes the Ignition orange, the same value as the pup's tee in the app. */}
    <g fill="var(--color-gf-ember)">
      {FIT.map((d, i) => (
        <path transform={`translate(${FIT_X[i]},0)`} d={d} />
      ))}
    </g>
  </svg>

  <!-- Both SVGs are aria-hidden; the name comes from here, so a screen reader
       announces "GameFit" once rather than twice or not at all. -->
  <span class="sr-only">GameFit</span>
</span>
