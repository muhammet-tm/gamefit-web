---
/**
 * Rank shield, ported from the shipped app's `RankEmblem.jsx`. The geometry is
 * identical so the marketing site and the product draw the same object.
 *
 * The ladder is ten levels across five tiers: Bronze (L1-2), Silver (L3-4),
 * Gold (L5-6), Platinum (L7-9), Apex (L10). Sub-ranks are Roman numerals and
 * render as pips along the foot of the shield. Apex has no sub-rank; it gets
 * the crown mark instead.
 */
type Tier = 1 | 2 | 3 | 4 | 5;

interface Props {
  tier: Tier;
  size?: number;
  showLabel?: boolean;
  /** Optional sub-rank, e.g. "II". One pip is drawn per character. */
  sub?: string;
  class?: string;
}

const { tier, size = 40, showLabel = false, sub = '', class: className = '' } = Astro.props;

const TIERS: Record<Tier, { name: string; color: string }> = {
  1: { name: 'Bronze', color: 'var(--color-tier-bronze)' },
  2: { name: 'Silver', color: 'var(--color-tier-silver)' },
  3: { name: 'Gold', color: 'var(--color-tier-gold)' },
  4: { name: 'Platinum', color: 'var(--color-tier-platinum)' },
  5: { name: 'Apex', color: 'var(--color-tier-apex)' },
};

const rank = TIERS[tier];
const display = sub ? `${rank.name} ${sub}` : rank.name;
const pips = tier === 5 ? [] : [...sub];
const height = Math.round(size * 1.12);
const labelSize = Math.max(10, Math.round(size * 0.26));
---
<span class={`inline-flex flex-col items-center gap-1 ${className}`}>
  <svg
    width={size}
    height={height}
    viewBox="0 0 44 50"
    role="img"
    aria-label={`Rank ${display}`}
  >
    <path
      d="M22,2 L39,8 C40,8.4 41,9.4 41,11 L41,26 C41,36 33,44 22,48 C11,44 3,36 3,26 L3,11 C3,9.4 4,8.4 5,8 Z"
      fill={rank.color}
      opacity="0.16"
    />
    <path
      d="M22,4 L37.5,9.6 C38.4,9.9 39,10.7 39,11.8 L39,26 C39,35 31.8,42.3 22,45.9 C12.2,42.3 5,35 5,26 L5,11.8 C5,10.7 5.6,9.9 6.5,9.6 Z"
      fill="none"
      stroke={rank.color}
      stroke-width="2.4"
    />
    <path d="M22,14 L31,20 L28,24 L22,20 L16,24 L13,20 Z" fill={rank.color} />
    <path d="M22,24 L29,28.5 L26.5,32 L22,29 L17.5,32 L15,28.5 Z" fill={rank.color} opacity="0.55" />
    {pips.map((_, i) => (
      <circle cx={22 + (i - (pips.length - 1) / 2) * 7} cy="38" r="2.2" fill={rank.color} />
    ))}
    {tier === 5 && (
      <path d="M15,36 L18,40 L22,36.5 L26,40 L29,36 L28,42 L16,42 Z" fill={rank.color} />
    )}
  </svg>
  {showLabel && (
    <span
      aria-hidden="true"
      class="font-display uppercase leading-none tracking-[0.06em]"
      style={`color:${rank.color};font-size:${labelSize}px`}
    >
      {display}
    </span>
  )}
</span>
