# Copy to .env and fill in.

# Web3Forms access key — obtained by entering an email at web3forms.com.
# Public by design: it ships in the client bundle. The domain restriction in
# the Web3Forms dashboard is what makes it safe, so set that before launch.
PUBLIC_WEB3FORMS_KEY=your-access-key-here

# Canonical site origin, no trailing slash.
# Local: http://localhost:4321   Production: https://your-domain
PUBLIC_SITE_URL=http://localhost:4321
